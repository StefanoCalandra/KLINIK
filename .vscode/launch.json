{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Avvia Clinica Aurora",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "disponibile su (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
