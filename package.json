{
  "name": "clinica-aurora",
  "version": "1.0.0",
  "private": true,
  "description": "Sito dimostrativo della Clinica Aurora",
  "scripts": {
    "start": "node server.mjs",
    "start:open": "node server.mjs --open",
    "check": "node --check wwwroot/script.js && node --check wwwroot/admin.js && node --check server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:api": "python3 tests/api_smoke.py",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:admin": "node tests/admin-browser.mjs",
    "test:booking": "node tests/booking-recovery.mjs",
    "test:auth": "python3 tests/auth_smoke.py",
    "test:login": "node tests/login-browser.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
